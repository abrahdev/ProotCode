---
import { features } from '../data/features'
---
<section class="sec wrap" id="features" style="max-width:none">
  <div class="sh"><h2>Thirteen<br>blocks.</h2><p class="lbl" style="max-width:300px">Roadmap features. The project is at initial scaffold; runtime is being built in the open.</p></div>
  <div class="grid">
    {features.map((feature) => (
      <div class:list={['cell', { hot: feature.hot }]}><span class="n">{feature.num}</span><div><h3>{feature.title}</h3><p>{feature.desc}</p>{feature.link && <a class="vm" href={feature.link.href}>{feature.link.text}</a>}</div></div>
    ))}
    <div class="cell" style="grid-column:span 3;background:var(--red);color:#fff;flex-direction:row;align-items:flex-end"><svg viewBox="0 0 1024 1024" style="width:150px;height:150px;flex:none"><use href="#gl"/></svg><h3 style="font-size:clamp(24px,3.4vw,48px)">Everything runs on your device.</h3></div>
  </div>
</section>

<style>
.grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:3px solid var(--line);border-left:3px solid var(--line);margin:0 -24px 0 0}
.cell{border-right:3px solid var(--line);border-bottom:3px solid var(--line);padding:20px;min-height:210px;display:flex;flex-direction:column;justify-content:space-between;gap:24px;transition:background .12s,color .12s}
.cell:hover{background:var(--red);color:#fff}
.cell .n{font:44px/1 var(--display);color:var(--red)}.cell:hover .n{color:#fff}
.cell h3{font:19px/1.1 var(--display);text-transform:uppercase;margin-bottom:8px}.cell p{font-size:12.5px}
.cell.hot{background:var(--ink);color:var(--paper)}
.vm{display:inline-flex;align-items:center;gap:8px;margin-top:12px;font:700 12px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--red);text-decoration:none}
.vm::after{content:'↓';font-size:15px}
.cell:hover .vm{color:#fff}
@media(max-width:900px){.grid{grid-template-columns:repeat(2,1fr);margin-right:0}}
@media(max-width:520px){.grid{grid-template-columns:1fr}}
</style>
